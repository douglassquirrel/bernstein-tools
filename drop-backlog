#!/usr/bin/env python3
"""drop-backlog: take Backlog out of a lobster project that has never used it. Run drop-backlog --help."""
import datetime
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from bernstein.dropbacklog import main  # noqa: E402

sys.exit(main(sys.argv[1:], dict(os.environ), datetime.datetime.now(datetime.timezone.utc), sys.stdout, sys.stderr,
              time.sleep))
